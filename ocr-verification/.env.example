# FastAPI
APP_NAME=OCR Transaction Verification
APP_HOST=0.0.0.0
APP_PORT=8010
DEBUG=true

# Production Finance / File APIs
FINANCE_API_BASE_URL=https://finance.api.gurukul.org
TRANSACTION_GET_PATH=/Transactions/GetTransaction/{transaction_id}
TRANSACTION_UPDATE_PATH=/Transactions/{transaction_id}?isMigration=false
TRANSACTION_LIST_PATH=/Transactions/GetAll

FILE_API_BASE_URL=https://files.api.gurukul.org
FILE_DOWNLOAD_PATH=/File/Download/{file_id}

# Auth — Angular should forward Authorization + Appid + Apikey to this API
API_AUTH_HEADER=Authorization
API_AUTH_TOKEN=
# Fallback when Angular does not forward Apikey (required by Files API)
FILE_API_KEY=
FILE_APP_ID=

# false = compare only, do not PUT narration / verified flag
UPDATE_ON_VERIFY=false

# Empty = all fetched transactions. Set an id to limit to one txn for testing.
BATCH_TEST_TRANSACTION_ID=

# Verification thresholds
AMOUNT_TOLERANCE=0.01
DATE_TOLERANCE_DAYS=0
PARTY_FUZZY_THRESHOLD=85
MIN_OCR_CONFIDENCE=0.55
MAX_PDF_PAGES=30
MAX_FILE_SIZE_MB=25
ENABLE_DESCRIPTION_CHECK=false

# OCR
OCR_LANG=en
USE_GPU=false
ENABLE_STRUCTURE_OCR=true
ENABLE_TROCR_FALLBACK=true
STRUCTURE_OCR_FOR_ALL_PAGES=false

# Local storage for verification history
HISTORY_DB_PATH=./temp/verification_history.db
TEMP_DIR=./temp

# Batch summary email (FREE Gmail SMTP only — no paid email API)
MAIL_TO=rutvik.d@gurukul.org
MAIL_FROM=
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your.email@gmail.com
SMTP_PASSWORD=your-16-char-app-password
SMTP_USE_TLS=true
